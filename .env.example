NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional SERVER-ONLY integrations; never use NEXT_PUBLIC_ for these keys.
OPENAI_API_KEY=
OPENAI_MODEL=
RESEND_API_KEY=
FOLLOWUP_FROM_EMAIL=
SUPABASE_SECRET_KEY=
CRON_SECRET=
BACKUPS_ENABLED=false

# Optional verified public price wording (defaults match the existing Shopify theme).
NEXT_PUBLIC_PRO_PRICE_LABEL=
NEXT_PUBLIC_CUSTOM_PRICE_LABEL=

# Detailing plans: Starter $49/1 user, Pro $100/5 users, Team $179/12 users.
# Graduated licensed prices charge the base fee, then $15 per additional user.
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_TIERS_PORTAL_CONFIGURATION_ID=
# Comma-separated previous Pro price IDs; retained for existing subscriber access.
STRIPE_LEGACY_PRO_PRICE_IDS=
